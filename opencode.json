{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "PROJECT_BLUEPRINT.md",
    "DESIGN_SYSTEM.md",
    "SECURITY.md",
    "SAAS_BUSINESS_MODEL.md",
    "docs/SLICES.md"
  ],
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "npm run *": "allow",
      "npx tsc *": "allow",
      "npx shadcn *": "allow",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls*": "allow",
      "cat*": "allow",
      "rm -rf*": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny"
    },
    "webfetch": "allow"
  }
}
