# =====================================================================
# AYOPILIH.ID — ENVIRONMENT VARIABLES
# Salin file ini jadi .env.local lalu isi nilainya.
# JANGAN commit .env.local ke git.
# Panduan lengkap: docs/ENV_SETUP.md
# =====================================================================

# ---------- SUPABASE (WAJIB) ----------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://owfketfzfxhixyihibfd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# ⚠️ RAHASIA — mem-bypass RLS. Server-only. Jangan diberi awalan NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# ---------- DOMAIN (WAJIB) ----------
# Dev  : localhost:3000
# Prod : ayopilih.id
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- KEAMANAN (WAJIB — buat sendiri dengan: openssl rand -base64 48) ----------
# Garam rahasia untuk hash token pemilih.
# ⚠️ JANGAN diubah setelah token dibagikan — semua token akan hangus.
TOKEN_PEPPER=ganti_dengan_48_byte_acak_base64

# Penandatangan cookie sesi bilik suara
SESSION_SECRET=ganti_dengan_48_byte_acak_base64

# PIN darurat keluar dari mode kios (6 digit)
KIOSK_MASTER_PIN=000000

# ---------- OPSIONAL: EMAIL (Slice 9+) ----------
RESEND_API_KEY=
EMAIL_FROM="AyoPilih <noreply@ayopilih.id>"

# ---------- OPSIONAL: WHATSAPP (Slice 9+, paket Pro) ----------
FONNTE_TOKEN=

# ---------- OPSIONAL: RATE LIMITING (Slice 10) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- OPSIONAL: SUPER ADMIN ----------
SUPER_ADMIN_EMAILS=emailkamu@gmail.com
